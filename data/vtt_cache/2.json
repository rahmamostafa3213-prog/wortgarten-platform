{"total": 76.20780045351474, "cues": [["ar", 0.3, 5.211020408163265, "أهلاً بيكي في درس التحيات والتعارف. اسمعي:"], ["de", 5.711020408163265, 8.834104308390023, "Hallo! Guten Morgen! Guten Tag! Guten Abend!"], ["ar", 9.334104308390023, 18.482766439909298, "Hallo أهلاً، Guten Morgen صباح الخير، Guten Tag نهارك سعيد، Guten Abend مساء الخير."], ["ar", 19.5827664399093, 22.775510204081634, "أول سؤال في أي تعارف:"], ["de", 23.275510204081634, 24.123038548752834, "Wie heißt du?"], ["ar", 24.623038548752838, 27.003083900226763, "يعني اسمك إيه؟ والرد:"], ["de", 27.50308390022676, 29.047210884353742, "Ich heiße Sara. Und du?"], ["ar", 29.547210884353746, 31.753106575963724, "اسمي سارة. وإنتي؟"], ["ar", 32.853106575963714, 34.57138321995465, "تاني سؤال مهم:"], ["de", 35.07138321995465, 36.06984126984127, "Woher kommst du?"], ["ar", 36.56984126984127, 39.007936507936506, "يعني إنتي منين؟ والرد:"], ["de", 39.507936507936506, 40.84308390022676, "Ich komme aus Ägypten."], ["ar", 41.34308390022676, 42.65501133786848, "أنا من مصر."], ["ar", 43.755011337868474, 46.494965986394554, "وفي آخر التعارف بنقول:"], ["de", 46.994965986394554, 47.761224489795914, "Freut mich!"], ["ar", 48.261224489795914, 51.02439909297052, "اتشرفت. ولما بنسيب بعض:"], ["de", 51.52439909297052, 52.987256235827665, "Tschüss! Bis bald!"], ["ar", 53.48725623582766, 56.3317006802721, "مع السلامة، أشوفك قريب."], ["ar", 57.4317006802721, 59.99750566893423, "اسمعي محادثة كاملة:"], ["de", 60.49750566893424, 62.68018140589569, "Hallo! Ich heiße Lena. Und du?"], ["de", 63.18018140589569, 65.11904761904762, "Ich heiße Sara. Freut mich!"], ["de", 65.61904761904762, 67.32571428571428, "Woher kommst du, Sara?"], ["de", 67.82571428571428, 69.0447619047619, "Ich komme aus Ägypten."], ["ar", 69.5447619047619, 75.40780045351474, "برافو! دي أول محادثة كاملة. جربيها بصوت عالي."]]}