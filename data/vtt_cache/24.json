{"total": 47.542811791383215, "cues": [["ar", 0.3, 6.673877551020408, "الأرقام الألمانية فيها نطق بيتلخبط. هنتعلم الأصعب."], ["ar", 7.773877551020408, 14.554104308390023, "zwei بتتنطق تسڤاي، وdrei درآي. اسمعي:"], ["de", 15.054104308390023, 16.54018140589569, "eins. zwei. drei. vier. fünf."], ["ar", 17.640181405895692, 23.375510204081635, "sechs بتتنطق زكس. وsieben بتتنطق زيبن. اسمعي:"], ["de", 23.875510204081632, 25.51251700680272, "sechs. sieben. acht. neun. zehn."], ["ar", 26.612517006802722, 34.913650793650795, "من 13 لـ 19 كل رقم بينتهي بـ zehn، والنبرة عليها. اسمعي:"], ["de", 35.413650793650795, 37.329297052154196, "dreizehn. vierzehn. sechzehn. siebzehn."], ["ar", 38.42929705215419, 43.537687074829925, "والعشرات بتنتهي بـ zig، والنبرة في الأول. اسمعي:"], ["de", 44.03768707482993, 46.74281179138322, "zwanzig. dreißig. vierzig. fünfzig. hundert."]]}